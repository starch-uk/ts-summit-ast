{
  "name": "ts-summit-ast",
  "version": "0.5.3",
  "description": "TypeScript port of Summit-AST - Abstract Syntax Tree for Salesforce Apex source code",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "bin": {
    "summit-tool": "./lib/tool/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./esm/utils/index.js",
      "require": "./lib/utils/index.js"
    }
  },
  "files": [
    "lib",
    "esm",
    "src"
  ],
  "scripts": {
    "build": "tsc && tsc --project tsconfig.esm.json",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.esm.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs": "typedoc src",
    "clean": "rm -rf lib esm"
  },
  "keywords": [
    "apex",
    "salesforce",
    "ast",
    "abstract-syntax-tree",
    "parser",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/summit-ast.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "agent-docs": "^1.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
