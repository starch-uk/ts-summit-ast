{
  "name": "ts-summit-ast",
  "version": "0.4.0",
  "description": "TypeScript port of Summit-AST - Abstract Syntax Tree for Salesforce Apex source code",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "bin": {
    "summit-tool": "./lib/tool/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./esm/utils/index.js",
      "require": "./lib/utils/index.js"
    }
  },
  "files": [
    "lib",
    "esm",
    "src"
  ],
  "scripts": {
    "build": "tsc && tsc --project tsconfig.esm.json",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs": "typedoc src",
    "clean": "rm -rf lib esm"
  },
  "keywords": [
    "apex",
    "salesforce",
    "ast",
    "abstract-syntax-tree",
    "parser",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/summit-ast.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
